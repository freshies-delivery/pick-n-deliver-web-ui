{
  "/api": {
    "target": "http://localhost:8082",
    "secure": false,
    "changeOrigin": true,
    "logLevel": "debug",
    "pathRewrite": { "^/api": "/api/admin-app/api" }
  },
  "/ws": {
    "target": "http://localhost",
    "secure": false,
    "changeOrigin": true,
